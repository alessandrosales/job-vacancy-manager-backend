# Copie para `.env.docker` e use com: docker compose --env-file .env.docker up --build

# --- Caminho do frontend (repositório irmão ou caminho absoluto no servidor) ---
FRONTEND_BUILD_CONTEXT=../job-vacancy-manager-layout

# --- Portas no host ---
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Rails (obrigatório em produção) ---
# Cole aqui o CONTEÚDO de config/master.key (uma linha), não o caminho do arquivo.
RAILS_MASTER_KEY=

# --- PostgreSQL EXTERNO (fora do Compose) ---
# No mesmo host que o Docker (Linux): host.docker.internal é mapeado via host-gateway no compose.
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=job_vacancy_manager_production

# Se o Postgres escuta só em 127.0.0.1 no host, permita conexões do Docker (ex.: pg_hba + listen)
# ou use a rede bridge do host conforme sua infra.

# Primeiro boot lento ou travando: verifique DATABASE_* e firewall; ou rode migrations na mão e use:
# SKIP_DB_PREPARE=true
SKIP_DB_PREPARE=false

# --- URL pública da API (navegador no host → backend publicado) ---
# Se o Nginx do aaPanel não repassar OPTIONS (erro CORS no preflight), veja
# docs/nginx-hireest-cors-and-proxy.example.conf — snippet OPTIONS ou proxy /api na mesma origem.
VITE_API_BASE_URL=http://localhost:3000

# --- CORS / SPA pública ---
# FRONTEND_URL define CORS + links nos e-mails (reset de senha) + default_url_options do Action Mailer (config/mailer_env.rb).
# Cole SMTP_* neste arquivo se sobe com: docker compose --env-file .env.docker (Compose não injeta vars não listadas em docker-compose.yml).
# Inclua origens extras: CORS_ORIGINS=https://www.hireest.com
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Envio SMTP (remetente + servidor) ---
SMTP_DEFAULT_FROM="Hireest <no-reply@hireest.com>"
SMTP_ADDRESS=127.0.0.1
SMTP_PORT=1025
# Opcional HELO/EHLO: se vazio, usa o host da FRONTEND_URL (ex.: hireest.com).
SMTP_DOMAIN=
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=false

# Produção via Resend: https://resend.com/docs/send-with-smtp
# SMTP_ADDRESS=smtp.resend.com / SMTP_USER_NAME=resend / SMTP_PASSWORD=re_xxx
# Com 587: SMTP_PORT=587, SMTP_ENABLE_STARTTLS_AUTO=true, SMTP_SSL=false
# Com 465: SMTP_PORT=465, SMTP_ENABLE_STARTTLS_AUTO=false, SMTP_SSL=true
#
# Opcional legado — só se precisar desacoplar URL do SPA da URL base dos helpers do mailer:
# MAILER_DEFAULT_URL_HOST=api.seudominio.com
# MAILER_DEFAULT_URL_PROTOCOL=https
# MAILER_DEFAULT_URL_PORT=

# MAILER_DEFAULT_FROM vale como fallback se SMTP_DEFAULT_FROM estiver em branco.

# Opcional: propagar erros de entrega (development)
# MAILER_RAISE_DELIVERY_ERRORS=true

# --- Firebase (build do frontend; todas obrigatórias no Docker) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend Firebase / AI (opcional) ---
FIREBASE_PROJECT_ID=
OPENAI_API_KEY=
