# Copie para `.env.docker` e use com: docker compose --env-file .env.docker up --build

# --- Caminho do frontend (repositório irmão) ---
FRONTEND_BUILD_CONTEXT=../job-vacancy-manager-layout

# --- Portas no host ---
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Rails (obrigatório em produção) ---
# Valor de config/master.key (não commite o arquivo real)
RAILS_MASTER_KEY=

# --- PostgreSQL (usuário criado pelo compose) ---
POSTGRES_USER=jobvacancy
POSTGRES_PASSWORD=jobvacancy
POSTGRES_DB=job_vacancy_manager_production

# --- URL pública da API (navegador no host → backend publicado) ---
VITE_API_BASE_URL=http://localhost:3000

# --- CORS / links no backend ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- E-mail (URLs em links; SMTP opcional) ---
MAILER_DEFAULT_URL_HOST=localhost
MAILER_DEFAULT_URL_PORT=3000
MAILER_DEFAULT_URL_PROTOCOL=http

# --- Firebase (build do frontend; todas obrigatórias no Docker) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend Firebase / AI (opcional) ---
FIREBASE_PROJECT_ID=
OPENAI_API_KEY=
