#!/usr/bin/env bash
set -e

# When starting the web server (Puma direto ou via Thruster), garantir schema/migrations.
prepare_db=false
case "${1:-}" in
  ./bin/rails)
    [ "${2:-}" = "server" ] && prepare_db=true
    ;;
  ./bin/thrust)
    prepare_db=true
    ;;
esac

if [ "$prepare_db" = true ] && [ "${SKIP_DB_PREPARE:-false}" != "true" ]; then
  echo "[docker-entrypoint] Running db:prepare (postgres deve estar acessível em \$DATABASE_HOST:\$DATABASE_PORT)..."
  ./bin/rails db:prepare
  echo "[docker-entrypoint] db:prepare finished; starting web server..."
elif [ "$prepare_db" = true ]; then
  echo "[docker-entrypoint] SKIP_DB_PREPARE=true — pulando db:prepare (rode migrations manualmente se precisar)."
fi

exec "$@"
