#!/usr/bin/env bash
set -e

# When starting the web server (Puma direto ou via Thruster), garantir schema/migrations.
prepare_db=false
case "${1:-}" in
  ./bin/rails)
    [ "${2:-}" = "server" ] && prepare_db=true
    ;;
  ./bin/thrust)
    prepare_db=true
    ;;
esac

if [ "$prepare_db" = true ]; then
  ./bin/rails db:prepare
fi

exec "$@"
