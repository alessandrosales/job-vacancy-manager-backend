# Copy to `.env` for local development (`cp .env.example .env`).

# PostgreSQL (Active Record). Em desenvolvimento, `DATABASE_NAME` vazio usa
# `job_vacancy_manager_development`; em testes, `job_vacancy_manager_test`.
# Produção: defina `DATABASE_NAME` (primário); cache, fila e cable usam sufixos `_cache`, `_queue` e `_cable`.
# Opcional: `DATABASE_CACHE_NAME` para sobrescrever só o banco de cache.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_CACHE_NAME=

# SPA base URL (password reset links, etc.)
FRONTEND_URL=http://localhost:5173
FIREBASE_PROJECT_ID=jobfy-platform

# Action Mailer
MAILER_DEFAULT_FROM="noreply <noreply@example.com>"
MAILER_DEFAULT_URL_HOST=localhost
MAILER_DEFAULT_URL_PORT=3000
MAILER_DEFAULT_URL_PROTOCOL=https

# SMTP (Mailpit / MailHog local: 1025)
SMTP_ADDRESS=127.0.0.1
SMTP_PORT=1025
SMTP_DOMAIN=localhost:3000
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=false

# Resend (SMTP): https://resend.com/docs/send-with-smtp — use um destes pares (porta + TLS):
# Opção A — STARTTLS (recomendado)
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER_NAME=resend
# SMTP_PASSWORD=re_xxxxxxxx        # API key
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_SSL=false
# Opção B — SMTPS
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER_NAME=resend
# SMTP_PASSWORD=re_xxxxxxxx
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=false
# SMTP_SSL=true
# MAILER_DEFAULT_FROM deve usar domínio verificado na Resend (ex.: Nome <onboarding@resend.dev> ou seu domínio).

# Optional: raise mail errors in development (see config/initializers/action_mailer_smtp.rb)
# MAILER_RAISE_DELIVERY_ERRORS=true

# RubyLLM (config/initializers/ruby_llm.rb). AI routes use each user's `ai_token` from My data first;
# set OPENAI_API_KEY only as a server-wide fallback when no personal key is stored.
OPENAI_API_KEY=
RUBY_LLM_REQUEST_TIMEOUT=120
RUBY_LLM_MAX_RETRIES=3
