# Copy to `.env` for local development (`cp .env.example .env`).

# SPA base URL (password reset links, etc.)
FRONTEND_URL=http://localhost:5173

# Action Mailer
MAILER_DEFAULT_FROM="noreply <noreply@example.com>"
MAILER_DEFAULT_URL_HOST=localhost
MAILER_DEFAULT_URL_PORT=3000
MAILER_DEFAULT_URL_PROTOCOL=https

# SMTP (Mailpit / MailHog local: 1025)
SMTP_ADDRESS=127.0.0.1
SMTP_PORT=1025
SMTP_DOMAIN=localhost:3000
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=false

# Optional: raise mail errors in development (see config/initializers/action_mailer_smtp.rb)
# MAILER_RAISE_DELIVERY_ERRORS=true

# RubyLLM (config/initializers/ruby_llm.rb) — necessário para import de currículo PDF
OPENAI_API_KEY=
RUBY_LLM_REQUEST_TIMEOUT=120
RUBY_LLM_MAX_RETRIES=3
